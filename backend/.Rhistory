# Load libraries
library(tidytext)
library(dplyr)
library(ggplot2)
library(stopwords)
# Sample data
reviews <- data.frame(
id = 1:5,
text = c(
"The product quality is excellent and delivery was quick!",
"Very poor customer service. I am disappointed.",
"Absolutely fantastic experience. Loved it!",
"The item arrived late and was damaged.",
"Great value for money. Will buy again!"
)
)
# Text preprocessing
reviews_clean <- reviews %>%
unnest_tokens(word, text) %>%
anti_join(get_stopwords(language = "en") %>%
dplyr::select(word), by = "word")
# Get sentiment lexicon
bing_lexicon <- get_sentiments("bing")
# Join with sentiment words
sentiment_words <- reviews_clean %>%
inner_join(bing_lexicon, by = "word")
# Count sentiment
sentiment_count <- sentiment_words %>%
count(sentiment)
# Show table
print(sentiment_count)
# Plot
ggplot(sentiment_count, aes(x = sentiment, y = n, fill = sentiment)) +
geom_bar(stat = "identity") +
ggtitle("Sentiment Polarity of Customer Reviews") +
ylab("Word Count") +
xlab("Sentiment")
# Load necessary libraries
library(forecast)
library(tseries)
# Step 1: Load the AirPassengers dataset
data("AirPassengers")
# Step 2: Plot original data
plot(AirPassengers,
main = "Monthly Air Passengers (1949-1960)",
ylab = "Number of Passengers",
col = "blue")
# Step 3: Decompose the time series
decomposed <- decompose(AirPassengers)
plot(decomposed)
# Step 4: Fit ARIMA model
arima_model <- auto.arima(AirPassengers)
# Step 5: Forecast next 12 months
forecast_data <- forecast(arima_model, h = 12)
# Step 6: Plot the forecast
plot(forecast_data, main = "Forecast of Air Passengers for Next 12 Months")
